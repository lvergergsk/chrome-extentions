{
  "manifest_version": 3,
  "name": "Utils",
  "description": "Personal utilities, including X image/video download and Sukebei/ouo.io ad blocking.",
  "version": "0.3.6",
  "key": "",
  "action": {
    "default_title": "Utils",
    "default_popup": "popup.html"
  },
  "permissions": [
    "downloads",
    "declarativeNetRequest",
    "history"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sukebei_adblock",
        "enabled": true,
        "path": "rules/adblock.json"
      }
    ]
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://cdn.syndication.twimg.com/*",
    "*://sukebei.nyaa.si/*",
    "*://*.sukebei.nyaa.si/*",
    "*://nyaa.si/*",
    "*://*.nyaa.si/*",
    "*://ouo.io/*",
    "*://*.ouo.io/*",
    "*://ouo.press/*",
    "*://*.ouo.press/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-media-core.js",
        "x-media-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-media-core.js",
        "x-media.js"
      ],
      "css": [
        "x-media.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://sukebei.nyaa.si/*",
        "*://*.sukebei.nyaa.si/*",
        "*://nyaa.si/*",
        "*://*.nyaa.si/*"
      ],
      "js": [
        "sukebei-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://sukebei.nyaa.si/*",
        "*://*.sukebei.nyaa.si/*",
        "*://nyaa.si/*",
        "*://*.nyaa.si/*"
      ],
      "js": [
        "sukebei-adblock.js",
        "sukebei-list-flags.js",
        "sukebei-open-unseen.js"
      ],
      "css": [
        "sukebei-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ouo.io/*",
        "*://*.ouo.io/*",
        "*://ouo.press/*",
        "*://*.ouo.press/*"
      ],
      "js": [
        "ouo-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ouo.io/*",
        "*://*.ouo.io/*",
        "*://ouo.press/*",
        "*://*.ouo.press/*"
      ],
      "js": [
        "ouo-adblock.js"
      ],
      "css": [
        "ouo-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}
