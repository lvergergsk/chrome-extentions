{
  "manifest_version": 3,
  "name": "Utils",
  "description": "Personal utilities, including HoYoLAB check-in, media download, and ad blocking.",
  "version": "0.10.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "action": {
    "default_title": "Utils",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "downloads",
    "declarativeNetRequest",
    "history",
    "alarms",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sukebei_adblock",
        "enabled": true,
        "path": "rules/adblock.json"
      },
      {
        "id": "pixiv_media",
        "enabled": true,
        "path": "rules/pixiv-media.json"
      }
    ]
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://www.pixiv.net/*",
    "https://i.pximg.net/*",
    "https://sg-act-public-api.hoyolab.com/*",
    "https://sg-public-api.hoyolab.com/*",
    "https://sg-hk4e-api.hoyolab.com/*",
    "https://sg-hkrpg-api.hoyolab.com/*",
    "https://public-operation-nap.hoyolab.com/*",
    "https://hoyo-codes.seria.moe/*",
    "*://sukebei.nyaa.si/*",
    "*://*.sukebei.nyaa.si/*",
    "*://nyaa.si/*",
    "*://*.nyaa.si/*",
    "*://ouo.io/*",
    "*://*.ouo.io/*",
    "*://ouo.press/*",
    "*://*.ouo.press/*",
    "*://orangepix.is/*",
    "*://*.orangepix.is/*",
    "*://kemono.cr/*",
    "*://*.kemono.cr/*",
    "*://gamebanana.com/*",
    "*://*.gamebanana.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-media-core.js",
        "x-media-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-media-core.js",
        "x-media.js"
      ],
      "css": [
        "x-media.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "pixiv-media-core.js",
        "pixiv-media-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "pixiv-media-core.js",
        "pixiv-media.js"
      ],
      "css": [
        "pixiv-media.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-media-core.js",
        "youtube-media-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-media-core.js",
        "youtube-media.js"
      ],
      "css": [
        "youtube-media.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://sukebei.nyaa.si/*",
        "*://*.sukebei.nyaa.si/*",
        "*://nyaa.si/*",
        "*://*.nyaa.si/*"
      ],
      "js": [
        "sukebei-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://sukebei.nyaa.si/*",
        "*://*.sukebei.nyaa.si/*",
        "*://nyaa.si/*",
        "*://*.nyaa.si/*"
      ],
      "js": [
        "sukebei-adblock.js",
        "sukebei-list-flags.js",
        "sukebei-open-unseen.js"
      ],
      "css": [
        "sukebei-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ouo.io/*",
        "*://*.ouo.io/*",
        "*://ouo.press/*",
        "*://*.ouo.press/*"
      ],
      "js": [
        "ouo-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ouo.io/*",
        "*://*.ouo.io/*",
        "*://ouo.press/*",
        "*://*.ouo.press/*"
      ],
      "js": [
        "ouo-adblock.js"
      ],
      "css": [
        "ouo-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://orangepix.is/*",
        "*://*.orangepix.is/*"
      ],
      "js": [
        "orangepix-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://orangepix.is/*",
        "*://*.orangepix.is/*"
      ],
      "js": [
        "orangepix-adblock.js"
      ],
      "css": [
        "orangepix-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://kemono.cr/*",
        "*://*.kemono.cr/*"
      ],
      "js": [
        "kemono-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://kemono.cr/*",
        "*://*.kemono.cr/*"
      ],
      "js": [
        "kemono-adblock.js"
      ],
      "css": [
        "kemono-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://gamebanana.com/*",
        "*://*.gamebanana.com/*"
      ],
      "js": [
        "gamebanana-adblock-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://gamebanana.com/*",
        "*://*.gamebanana.com/*"
      ],
      "js": [
        "gamebanana-adblock.js"
      ],
      "css": [
        "gamebanana-adblock.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}
